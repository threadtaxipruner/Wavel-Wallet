{
  "name": "wavel-wallet",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "Local-first desktop EVM wallet",
  "license": "MIT",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "npm run clean && npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "clean": "node scripts/clean.cjs",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "ethers": "6.17.0"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "electron": "37.2.0",
    "electron-builder": "26.0.12",
    "typescript": "5.8.3",
    "vite": "7.0.4",
    "vitest": "3.2.4"
  },
  "build": {
    "appId": "org.wavelwallet.desktop",
    "productName": "Wavel Wallet",
    "artifactName": "Wavel-Wallet-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist/renderer/**/*",
      "package.json",
      "LICENSE"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Wavel Wallet",
      "deleteAppDataOnUninstall": false
    }
  }
}
